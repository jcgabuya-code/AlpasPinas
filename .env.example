# Roster still uses an Apps Script web app URL (ends in /exec — see
# google/ROSTER-SETUP.md). Leave blank to run in local-only mode (bundled JSON).
VITE_ROSTER_ENDPOINT=

# Training sign-ups now live in Supabase (public.training_signups) — no endpoint
# var needed; they use the VITE_SUPABASE_* config below.

# --- Supabase (user / admin / training data) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Registration email mailer (Apps Script) ---
# Must match MAILER_SECRET in google/roster-script.gs.
VITE_MAILER_SECRET=

# --- Dev only ---
# Set to 1 to fill the admin Boat Assignments bench with sample athletes
# (src/utils/seedBookings.ts) instead of reading the live sheet. Leave unset
# in production.
VITE_SEED_BOOKINGS=
